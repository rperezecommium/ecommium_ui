{
  "name": "ecommium_ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10.9.2 <11"
  },
  "scripts": {
    "dev": "next dev --webpack -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "next build && playwright test",
    "pw:open": "playwright open about:blank",
    "pw:show": "playwright-cli show --annotate",
    "pw:close": "echo 'Close the Playwright window to stop the session'",
    "pw:snapshot": "playwright-cli snapshot",
    "pw:codegen": "playwright codegen http://localhost:5173",
    "pw:report": "playwright show-report"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/sanitize-html": "^2.16.1",
    "lucide-react": "^1.21.0",
    "next": "16.3.0",
    "react": "latest",
    "react-dom": "latest",
    "sanitize-html": "^2.17.6"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
}
